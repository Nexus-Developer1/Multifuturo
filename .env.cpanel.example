# Multifuturo Propriedades — .env do ALOJAMENTO cPanel (modelo).
#
# Copiar para ~/multifuturo/.env no Gestor de Ficheiros e preencher. Nunca
# entra no Git. É o modelo para o alojamento partilhado, sem Docker e sem
# Redis; para o servidor em contentores é o .env.production.example.
#
# As linhas marcadas com [OBRIGATÓRIO] têm de estar preenchidas: a aplicação
# recusa arrancar em produção sem AGENCY_AMI.

# --- Aplicação ---------------------------------------------------------------
APP_NAME="Multifuturo Propriedades"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Europe/Lisbon
# Deixar vazio na primeira instalação: o instalar.sh gera a chave.
APP_KEY=
# [OBRIGATÓRIO] o endereço público, com https e sem barra no fim. É este que
# manda: quem entrar por www.multifuturo.pt é reencaminhado para aqui.
APP_URL=https://multifuturo.pt

APP_LOCALE=pt
APP_LOCALES=pt,en
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT

SITE_DOMAIN=multifuturo.pt

# --- Logs --------------------------------------------------------------------
# No alojamento não há Docker a recolher a saída: os logs vão para ficheiro,
# em storage/logs, e guardam-se 14 dias.
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- Base de dados (MySQL do cPanel) -----------------------------------------
# O cPanel prefixa o nome da conta: multifut_multifuturo, multifut_site, etc.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
# [OBRIGATÓRIO] a do utilizador criado em "MySQL Databases", entre aspas.
DB_PASSWORD=
DB_COLLATION=utf8mb4_0900_ai_ci

# --- Cache, sessões e fila (sem Redis) ---------------------------------------
# No alojamento partilhado não há Redis. As sessões e a cache vão para a base
# de dados, que sobrevive a limpezas da pasta temporária; a fila também, e o
# Cron Job de minuto a minuto é que a despacha (ver DEPLOY.md).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Email (SMTP do domínio, no cPanel) --------------------------------------
# [OBRIGATÓRIO] sem isto os pedidos do site não chegam a ninguém.
# A conta de envio é a info@multifuturo.pt, criada em "Email Accounts".
MAIL_MAILER=smtp
MAIL_HOST=mail.multifuturo.pt
MAIL_PORT=587
MAIL_USERNAME=info@multifuturo.pt
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=info@multifuturo.pt
MAIL_FROM_NAME="${APP_NAME}"

# --- Agência -----------------------------------------------------------------
AGENCY_NAME="Multifuturo Propriedades"
# [OBRIGATÓRIO] só o número; obrigatório por lei, a app não arranca sem ele
AGENCY_AMI=27737
AGENCY_PHONE="912 178 876"
AGENCY_EMAIL=geral@multifuturo.pt
AGENCY_ADDRESS="Rua de Brito Capelo 598 2º andar sala 2.4, Matosinhos, Portugal, 4450-067"
AGENCY_WHATSAPP="+351 912 178 876"
AGENCY_LAT=41.1824813
AGENCY_LON=-8.6900963
AGENCY_FACEBOOK=https://www.facebook.com/profile.php?id=61593793061476
AGENCY_INSTAGRAM=https://www.instagram.com/multi_futuro
AGENCY_LINKEDIN=
AGENCY_COMPLAINTS_BOOK_URL=https://www.livroreclamacoes.pt/
AGENCY_PRIVACY_POLICY_VERSION=2026-08-24
AGENCY_HERO_IMAGE=

# --- Portal e cópias de segurança --------------------------------------------
PORTAL_MFA=false
PORTAL_NAME="Multifuturo Propriedades"
# As cópias ficam em storage/backups; o Cron do schedule:run é que as corre.
BACKUP_AT=03:30
BACKUP_KEEP_DAYS=14

# --- Tradução automática (DeepL) ---------------------------------------------
# Sem chave, os botões de tradução não aparecem no backoffice e nada mais muda.
DEEPL_KEY=
DEEPL_TARGET=EN-GB
