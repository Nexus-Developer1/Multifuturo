APP_NAME="Multifuturo Propriedades"
APP_ENV=local
APP_TIMEZONE=Europe/Lisbon
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/multifuturo

APP_LOCALE=pt
APP_LOCALES=pt,en
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=multifuturo
DB_USERNAME=sail
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="geral@multifuturo.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Sail / Docker ---
COMPOSE_PROJECT_NAME=multifuturo
APP_SERVICE=multifuturo.test
APP_PORT=80
FORWARD_DB_PORT=54320
FORWARD_REDIS_PORT=63790


# --- AgÃªncia ---
AGENCY_NAME="Multifuturo Propriedades"
AGENCY_AMI=
AGENCY_PHONE=
# Email geral da agência (rodapé, JSON-LD). Os pedidos do site chegam por email a cada
# administrador do backoffice e, se preenchido, também a este endereço.
AGENCY_EMAIL=geral@multifuturo.pt
AGENCY_ADDRESS="Matosinhos e Leça da Palmeira, Rua Brito Capelo, nº 598 2º – Escritório 2.4"
AGENCY_FACEBOOK=
AGENCY_INSTAGRAM=
AGENCY_LINKEDIN=

# Sail (Windows/Docker Desktop): utilizador dentro do container
WWWUSER=1000
WWWGROUP=1000
AGENCY_COMPLAINTS_BOOK_URL=https://www.livroreclamacoes.pt/
AGENCY_PRIVACY_POLICY_VERSION=2026-08-24
AGENCY_HERO_IMAGE=

# Cópias de segurança: hora da cópia diária e quantos dias guardar.
# Portal da equipa: verificação em duas etapas por email (código de 6 algarismos).
# Segunda etapa por email no login do portal. Recomendado em produção.
PORTAL_MFA=false
# Nome da plataforma no login e no portal (a ponte para os modulos; nao e o da agencia).
PORTAL_NAME="Multifuturo Propriedades"
BACKUP_AT=03:30
BACKUP_KEEP_DAYS=14
