# Multifuturo Propriedades — .env de PRODUÇÃO (modelo).
#
# Copiar para .env no servidor e preencher. Nunca entra no Git.
# As linhas marcadas com [OBRIGATÓRIO] têm de estar preenchidas antes do
# primeiro arranque; a aplicação recusa arrancar em produção sem AGENCY_AMI.

# --- Aplicação ---------------------------------------------------------------
APP_NAME="Multifuturo Propriedades"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Europe/Lisbon
# [OBRIGATÓRIO] gerar com: docker compose -f compose.production.yaml run --rm app php artisan key:generate --show
APP_KEY=
# [OBRIGATÓRIO] o endereço público, com https e sem barra no fim
APP_URL=https://multifuturo.pt

APP_LOCALE=pt
APP_LOCALES=pt,en
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT

# --- Domínio -----------------------------------------------------------------
# [OBRIGATÓRIO] o domínio tal como aponta para este servidor (sem https://)
SITE_DOMAIN=multifuturo.pt
# Email para os avisos do Let's Encrypt (renovação, problemas com o certificado)
# Porta HTTP do contentor Apache. O HTTPS termina à frente: o Apache/painel
# do servidor anfitrião faz proxy para esta porta (DEPLOY.md §10).
HTTP_PORT=8080

# --- Logs --------------------------------------------------------------------
# stderr: os logs vão para o Docker (docker compose logs app). Sem ficheiros a crescer.
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- Base de dados -----------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=multifuturo
DB_USERNAME=multifuturo
# [OBRIGATÓRIO] longa e aleatória: openssl rand -base64 32
DB_PASSWORD=
# Colação portuguesa: acentos ordenados como deve ser, comparações sem maiúsculas.
DB_COLLATION=utf8mb4_0900_ai_ci

# --- Cache, sessões, fila (Redis) --------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Email (SMTP real) -------------------------------------------------------
# [OBRIGATÓRIO] sem isto os pedidos do site não chegam a ninguém.
# A conta de envio é a info@multifuturo.pt, no email do domínio (cPanel).
# MAIL_USERNAME é essa conta e MAIL_PASSWORD a palavra-passe dela — entre
# aspas, que tem caracteres especiais. É o endereço que o cliente vê como
# remetente; as respostas da agência saem de AGENCY_EMAIL, mais abaixo.
MAIL_MAILER=smtp
MAIL_HOST=mail.multifuturo.pt
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
# Remetente: um endereço do próprio domínio, senão os emails caem no spam.
MAIL_FROM_ADDRESS=info@multifuturo.pt
MAIL_FROM_NAME="${APP_NAME}"

# --- Agência -----------------------------------------------------------------
AGENCY_NAME="Multifuturo Propriedades"
# [OBRIGATÓRIO] só o número (ex.: 12345); obrigatório por lei, a app não arranca sem ele
AGENCY_AMI=
AGENCY_PHONE="912 178 876"
# Recebe uma cópia de cada pedido do site (além de cada administrador do backoffice)
AGENCY_EMAIL=geral@multifuturo.pt
AGENCY_ADDRESS="Rua de Brito Capelo 598 2º andar sala 2.4, Matosinhos, Portugal, 4450-067"
# WhatsApp em formato internacional. Sem valor, a linha não aparece nos contactos.
AGENCY_WHATSAPP="+351 912 178 876"
# Onde fica o escritório, para o mapa da página de contactos. Sem as duas, não há mapa.
AGENCY_LAT=41.1824813
AGENCY_LON=-8.6900963
AGENCY_FACEBOOK=
AGENCY_INSTAGRAM=
AGENCY_LINKEDIN=
AGENCY_COMPLAINTS_BOOK_URL=https://www.livroreclamacoes.pt/
# Data da versão em vigor da política de privacidade (fica gravada em cada pedido)
AGENCY_PRIVACY_POLICY_VERSION=2026-08-24
# Fotografia do topo da página inicial (ex.: /storage/site/hero.jpg). Vazio: capa do primeiro destaque.
AGENCY_HERO_IMAGE=

# --- Tarefas agendadas -------------------------------------------------------
# Portal da equipa: verificação em duas etapas por email (código de 6 algarismos).
# Segunda etapa por email no login do portal. Recomendado em produção.
PORTAL_MFA=false
# Nome da plataforma no login e no portal (a ponte para os modulos; nao e o da agencia).
PORTAL_NAME="Multifuturo Propriedades"
BACKUP_AT=03:30
BACKUP_KEEP_DAYS=14

# --- Docker Compose ----------------------------------------------------------
COMPOSE_PROJECT_NAME=multifuturo

# Tradução automática dos textos dos imóveis (DeepL).
# Sem chave, os botões de tradução não aparecem no backoffice e nada mais muda.
# As chaves gratuitas terminam em ":fx" e falam com outro endereço, tratado sozinho.
DEEPL_KEY=
DEEPL_TARGET=EN-GB
